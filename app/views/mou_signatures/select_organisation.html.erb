<% set_page_title("Choose an organisation for MOU acceptance") %>
<% content_for :back_link, govuk_back_link_to(mou_delegations_path) %>
<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">Choose an organisation</h1>
    <ul class="govuk-list govuk-list--spaced">
      <% @delegation_targets.each do |delegation| %>
        <li>
          <%= govuk_link_to delegation.organisation.name, new_mou_signature_path(organisation_id: delegation.organisation_id) %>
          <span class="govuk-hint">Authority reference: <%= delegation.authority_reference %>; expires <%= delegation.expires_on.to_fs(:long) %></span>
        </li>
      <% end %>
    </ul>
  </div>
</div>
