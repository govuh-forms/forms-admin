<% page_title = @agreement_type == :crown ? t("page_titles.mou_signature_new") : t("page_titles.non_crown_agreement_new") %>
<% set_page_title(title_with_error_prefix(page_title, @mou_signature.errors.any?)) %>
<% content_for :back_link, govuk_back_link_to(root_path, t("back_link.forms")) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <%= form_with(model: @mou_signature, url: @create_path) do |f| %>
      <%= f.govuk_error_summary %>

      <h1 class="govuk-heading-l"><%= page_title %></h1>
      <p class="govuk-body">Organisation: <strong><%= @mou_signature.organisation.name %></strong></p>
      <% if @delegation.present? && !directly_authorised? %>
        <p class="govuk-body">Delegation reference: <strong><%= @delegation.authority_reference %></strong></p>
      <% end %>

      <% if @agreement_type == :crown %>
        <%= render "mou_version_current" %>
      <% else %>
        <%= render "non_crown_agreement_version_current" %>
      <% end %>

      <%= f.govuk_check_boxes_fieldset :agreed, multiple: false, legend: { tag: 'h2', size: 'm', text: t("helpers.legend.mou_signature.#{@agreement_type}_agreed") } do %>
        <%= f.govuk_check_box :agreed, 1, 0, multiple: false, link_errors: true, label: { text: t("helpers.label.mou_signature.#{@agreement_type}_agreed") } %>
      <% end %>

      <%= f.govuk_text_field :signatory_capacity, label: { text: "Your official capacity or authority to accept for this organisation" }, hint: { text: "For example, your job title or delegated capacity" } %>
      <%= f.govuk_check_box :authority_confirmed, "1", "0", multiple: false, label: { text: "I confirm that I have authority to accept this agreement on behalf of my organisation" } %>
      <%= f.govuk_submit "Accept memorandum for my organisation" %>
    <% end %>
  </div>
</div>
