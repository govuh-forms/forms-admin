<% set_page_title(title_with_error_prefix("Record an MOU delegation", @delegation.errors.any?)) %>
<% content_for :back_link, govuk_back_link_to(mou_delegations_path) %>

<div class="govuk-grid-row">
  <div class="govuk-grid-column-two-thirds">
    <h1 class="govuk-heading-l">Record an MOU delegation</h1>
    <p class="govuk-body">Organisation: <strong><%= @current_user.organisation.name %></strong></p>
    <%= form_with model: @delegation, url: mou_delegations_path do |f| %>
      <%= f.govuk_error_summary %>
      <%= f.govuk_email_field :delegate_email, label: { text: "GOV.UH Forms account email" }, hint: { text: "Use an existing Forms account." } %>
      <%= f.govuk_text_field :authorising_officer_name, label: { text: "Officer who authorised the delegation" } %>
      <%= f.govuk_text_field :authority_reference, label: { text: "Institutional decision or delegation reference" }, hint: { text: "Enter the reference for the recorded decision." } %>
      <%= f.govuk_text_area :authority_scope, label: { text: "Scope of the recorded authority" }, hint: { text: "Identify the power to accept this memorandum for the named organisation." } %>
      <%= f.govuk_text_field :expires_on, label: { text: "Delegation expiry date (YYYY-MM-DD)" } %>
      <%= f.govuk_check_box :authority_confirmed, "1", "0", multiple: false, label: { text: "I confirm that my organisation has authorised this delegation and the decision is recorded." } %>
      <%= f.govuk_submit "Record delegation" %>
    <% end %>
  </div>
</div>
