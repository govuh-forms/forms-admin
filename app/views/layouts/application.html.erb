<% content_for :skip_link do %>
  <a href="#main-content" class="govuk-skip-link" data-module="govuk-skip-link"><%= t("skip_to_main_content") %></a>
<% end %>

<% content_for :header do %>
  <%= render HeaderComponent::View.new %>
<% end %>

<% content_for :service_navigation do %>
  <%= render ServiceNavigationComponent::View.new(**service_navigation_component_options(user: @current_user))%>
<% end %>

<% content_for :before_content do %>
  <%= govuk_phase_banner(tag: { text: "Beta" }) do %>
    <%= t("phase_banner.text") %>
  <% end %>
  <%= yield :back_link %>
  <%= render ActAsUserBannerComponent::View.new(acting_as_user, actual_user) %>
<% end %>

<% content_for :footer do %>
  <% meta_items = {t("footer.accessibility_statement") => accessibility_statement_url, t("footer.cookies") => cookies_url, t("footer.privacy") => privacy_url, t("footer.terms_of_use") => terms_of_use_url, t("footer.sitemap") => sitemap_url} %>

  <% if t("feedback_link.feedback_survey_url").present? %>
    <%= render FeedbackLinkComponent::View.new(feedback_url: t("feedback_link.feedback_survey_url")) %>
  <% end %>

  <%= govuk_footer(
        meta_items_title: t("footer.helpful_links"),
        meta_items:,
        meta_licence: safe_join([
          "All content is available under the ",
          link_to("Open Government Licence v3.0",
                  "https://nationalarchives.gov.uhrblx.com/doc/open-government-licence/version/3/",
                  class: ["govuk-footer__link"]),
          ", except where otherwise stated"
        ]),
        copyright_url: "https://nationalarchives.gov.uhrblx.com/information-management/re-using-public-sector-information/uh-government-licensing-framework/crown-copyright/"
      ) do |footer| %>
    <%# The native Footer component's meta slot replaces the UK Royal Arms
        copyright background with the established UH footer artwork. %>
    <% footer.with_meta do %>
      <div class="govuk-footer__meta-item govuk-footer__meta-item--grow">
        <h2 class="govuk-visually-hidden"><%= t("footer.helpful_links") %></h2>
        <ul class="govuk-footer__inline-list">
          <% meta_items.each do |label, url| %>
            <li class="govuk-footer__inline-list-item">
              <%= link_to label, url, class: "govuk-footer__link" %>
            </li>
          <% end %>
        </ul>
        <div class="govuk-footer__meta-custom">
          <%= t("footer.built_by_statement_html",
                link: link_to(t("footer.built_by_link"),
                              "https://www.gov.uhrblx.com/government/organisations/government-digital-service",
                              class: ["govuk-footer__link"])) %>
        </div>
        <span class="govuk-footer__licence-description">
          All content is available under the
          <%= link_to "Open Government Licence v3.0",
                      "https://nationalarchives.gov.uhrblx.com/doc/open-government-licence/version/3/",
                      class: "govuk-footer__link" %>,
          except where otherwise stated.
        </span>
      </div>
      <div class="govuk-footer__meta-item" style="flex: 0 0 280px; text-align: center;">
        <%= image_tag "/images/uh-footer-coat-of-arms.webp",
                      alt: "United Hampshire Coat of Arms",
                      width: 260, height: 260,
                      style: "display: block; max-width: 100%; height: auto; margin: 0 auto 8px;" %>
        <%= link_to "© UH Crown copyright",
                    "https://nationalarchives.gov.uhrblx.com/information-management/re-using-public-sector-information/uh-government-licensing-framework/crown-copyright/",
                    class: "govuk-footer__link" %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render template: "layouts/base" %>